#########################################################################
# Makefile.cosmo
# Compatibility entry point for the APE (Actually Portable Executable)
# build. It no longer uses the retired cosmopolitan.h amalgamation
# (`gcc -include cosmopolitan.h -nostdlib ... ape.lds crt.o`); every APE
# target is built by Makefile.e9studio with the pinned cosmocc toolchain
# declared in tool/cosmocc.mk.
#
# Usage:
#   make -f Makefile.cosmo toolchain   # fetch + sha256-verify cosmocc
#   make -f Makefile.cosmo studio      # build/e9studio.com
#   make -f Makefile.cosmo check       # unit tests + self-test
#   make -f Makefile.cosmo wasm        # e9patch.wasm via Emscripten
#
# Not provided: an APE build of the upstream C++ rewriter (e9patch/e9tool).
# Its loaders are raw x86-64 Linux ELF/PE blobs and it uses Linux-only
# interfaces, so it is built natively with the upstream `Makefile`.
#########################################################################

.PHONY: all studio gui check clean toolchain help wasm e9patch.com

E9STUDIO_MAKE = $(MAKE) -f Makefile.e9studio

all studio: ; $(E9STUDIO_MAKE) all
gui: ; $(E9STUDIO_MAKE) gui
check: ; $(E9STUDIO_MAKE) check
clean: ; $(E9STUDIO_MAKE) clean
toolchain: ; $(E9STUDIO_MAKE) toolchain

e9patch.com:
	@echo "The upstream C++ rewriter is not built as an APE; use 'make' (upstream Makefile)." >&2
	@exit 2

#########################################################################
# WASM build of the patching core for browsers (Emscripten, not cosmocc)
#########################################################################

VERSION := $(shell cat VERSION 2>/dev/null || echo 0.0.0)
BUILD_DIR = build/wasm
EMCXX ?= em++
WASM_CXXFLAGS = -std=c++11 -Wall -Wno-reorder \
    -DVERSION=$(VERSION) -DE9_PLATFORM_WASM \
    -O2 -s WASM=1 -s MODULARIZE=1 \
    -s EXPORT_NAME='E9PatchModule' \
    -s EXPORTED_FUNCTIONS='["_e9cosmo_init","_e9cosmo_load_binary","_e9cosmo_apply_patch","_e9cosmo_get_patched_binary","_e9cosmo_free_patched_binary","_e9cosmo_on_source_change","_e9cosmo_set_breakpoint","_e9cosmo_clear_breakpoint","_e9cosmo_hot_reload","_e9cosmo_get_version","_malloc","_free"]' \
    -s EXPORTED_RUNTIME_METHODS='["ccall","cwrap","UTF8ToString","stringToUTF8"]' \
    -s ALLOW_MEMORY_GROWTH=1 \
    -s INITIAL_MEMORY=67108864

WASM_SRCS = \
    src/e9patch/platform/e9platform_wasm.cpp \
    src/e9patch/platform/e9cosmo.cpp \
    src/e9patch/e9alloc.cpp \
    src/e9patch/e9json.cpp \
    src/e9patch/e9x86_64.cpp \
    src/e9patch/e9trampoline.cpp \
    src/e9patch/e9tactics.cpp

wasm: $(BUILD_DIR)/e9patch.js $(BUILD_DIR)/e9patch_chrome.js

$(BUILD_DIR):
	mkdir -p $@

$(BUILD_DIR)/e9patch.js: $(WASM_SRCS) | $(BUILD_DIR)
	$(EMCXX) $(WASM_CXXFLAGS) $(WASM_SRCS) -o $@

$(BUILD_DIR)/e9patch_chrome.js: src/e9patch/web/e9patch_chrome.js | $(BUILD_DIR)
	cp $< $@

help:
	@echo "Makefile.cosmo targets: toolchain studio gui check clean wasm"
	@echo "APE targets forward to Makefile.e9studio (cosmocc, see tool/cosmocc.mk)."
