#########################################################################
# Makefile.e9studio
# Build e9studio.com - self-contained binary analysis and patching tool,
# as one Actually Portable Executable (Linux, macOS, Windows, BSDs;
# x86-64 and AArch64) produced by the pinned cosmocc toolchain.
#
# Usage:
#   make -f Makefile.e9studio toolchain  # fetch + sha256-verify cosmocc (once)
#   make -f Makefile.e9studio all        # build build/e9studio.com
#   make -f Makefile.e9studio check      # unit tests + self-test (fails on error)
#   make -f Makefile.e9studio clean
#   make -f Makefile.e9studio COSMOCC=/path/to/cosmocc-4.0.2 all
#   make -f Makefile.e9studio native     # host cc build (no APE, no ZipOS)
#########################################################################

.PHONY: all test check clean vendor native gui cli wasm binaryen debug help unit

include tool/cosmocc.mk
.DEFAULT_GOAL := all

# Compiler: the pinned cosmocc unless CC/AR were given on the command line
# or in the environment. (`CC ?=` cannot work here: make predefines CC=cc.)
ifeq ($(origin CC),default)
CC := $(COSMOCC)/bin/cosmocc
endif
ifeq ($(origin AR),default)
AR := $(COSMOCC)/bin/cosmoar
endif
ZIPCOPY ?= $(COSMOCC)/bin/zipcopy
ZIP ?= zip

# APE builds are the ones whose compiler is cosmocc
IS_COSMO := $(findstring cosmocc,$(notdir $(CC)))

NEEDS_CC := $(filter-out toolchain clean help native,$(or $(MAKECMDGOALS),all))
ifneq ($(IS_COSMO),)
ifneq ($(NEEDS_CC),)
ifeq ($(shell command -v $(CC) 2>/dev/null),)
$(error cosmocc $(COSMOCC_VERSION) not found at $(CC). Run 'make -f Makefile.e9studio toolchain' or pass COSMOCC=/path/to/cosmocc-$(COSMOCC_VERSION))
endif
endif
endif

VERSION := $(shell cat VERSION 2>/dev/null || echo 0.0.0)

# Flags
CFLAGS = -O2 -Wall -Wextra -std=c11 -D_GNU_SOURCE -D_XOPEN_SOURCE=700
# macOS hides MAP_ANONYMOUS/madvise under _XOPEN_SOURCE unless this is set
# (only matters for host-cc builds on macOS; other hosts ignore it)
CFLAGS += -D_DARWIN_C_SOURCE
CFLAGS += -I src/e9patch
CFLAGS += -I src/e9studio/gui
CFLAGS += -I src/e9patch/vendor
CFLAGS += -I src/e9patch/wasm
CFLAGS += -I src/e9patch/analysis
CFLAGS += -I src/e9patch/ide
# WAMR headers
CFLAGS += -I src/e9patch/vendor/wamr
CFLAGS += -I src/e9patch/vendor/wamr/core/iwasm/include
CFLAGS += -I src/e9patch/vendor/wamr/core/shared/platform/cosmopolitan
# WAMR feature flags
CFLAGS += -DWASM_ENABLE_FAST_JIT=1
CFLAGS += -DWASM_ENABLE_AOT=1
CFLAGS += -DWASM_ENABLE_INTERP=1
CFLAGS += -DWASM_ENABLE_FAST_INTERP=1
CFLAGS += -DBUILD_PLATFORM_COSMOPOLITAN=1

# Vendor library sources (self-contained analysis)
VENDOR_SRCS = \
    src/e9patch/vendor/e9signatures.c \
    src/e9patch/vendor/e9disasm_x86.c \
    src/e9patch/vendor/e9disasm_arm64.c \
    src/e9patch/vendor/e9vendor.c

# Analysis engine sources (CFG, symbol injection, decompilation, patching)
ANALYSIS_SRCS = \
    src/e9patch/analysis/e9analysis.c \
    src/e9patch/analysis/e9func_sigs.c \
    src/e9patch/analysis/e9decompile.c \
    src/e9patch/analysis/e9binpatch.c \
    src/e9patch/analysis/e9studio_analysis.c

# APE patching (PE-based, no ELF for x86-64), live reload, process memory
APE_SRCS = \
    src/e9patch/e9ape.c \
    src/e9patch/e9livereload.c \
    src/e9patch/e9procmem.c

# WAMR sources (WebAssembly Micro Runtime with Fast JIT)
WAMR_SRCS = \
    src/e9patch/vendor/wamr/core/iwasm/common/wasm_runtime_common.c \
    src/e9patch/vendor/wamr/core/shared/platform/cosmopolitan/platform_init.c

# IDE integration protocol
IDE_SRCS = \
    src/e9patch/ide/e9ide_protocol.c

# E9Studio main sources (TUI) with Binaryen integration
E9STUDIO_SRCS = \
    src/e9patch/wasm/e9wasm_host.c \
    src/e9patch/wasm/e9binaryen.c \
    src/e9patch/wasm/e9studio.c

# GUI Framework sources (tedit-cosmo inspired)
GUI_SRCS = \
    src/e9studio/gui/e9studio_gui.c \
    src/e9studio/gui/e9studio_app.c \
    src/e9studio/gui/e9studio_gui_main.c \
    src/e9studio/gui/platform/e9gui_cli.c

# Unit tests (test/unit/*_test.c, one program each)
UNIT_SRCS = $(wildcard test/unit/*_test.c)

# All sources
ALL_SRCS = $(VENDOR_SRCS) $(ANALYSIS_SRCS) $(WAMR_SRCS) $(IDE_SRCS) $(E9STUDIO_SRCS)
ALL_OBJS = $(ALL_SRCS:.c=.o)

# GUI sources
GUI_OBJS = $(GUI_SRCS:.c=.o)

# Output
BUILD_DIR = build
OUTPUT = $(BUILD_DIR)/e9studio.com
UNIT_BINS = $(patsubst test/unit/%.c,$(BUILD_DIR)/unit/%.com,$(UNIT_SRCS))

# Files embedded in the APE's ZipOS (read at run time from /zip/...)
ASSETS_DIR = $(BUILD_DIR)/assets
ASSETS_ZIP = $(BUILD_DIR)/assets.zip

#########################################################################
# Main targets
#########################################################################

all: $(OUTPUT)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# Build vendor library first (includes WAMR)
vendor: $(BUILD_DIR)/libe9vendor.a

VENDOR_OBJS = $(VENDOR_SRCS:.c=.o)
ANALYSIS_OBJS = $(ANALYSIS_SRCS:.c=.o)
WAMR_OBJS = $(WAMR_SRCS:.c=.o)
IDE_OBJS = $(IDE_SRCS:.c=.o)
APE_OBJS = $(APE_SRCS:.c=.o)

$(BUILD_DIR)/libe9vendor.a: $(VENDOR_OBJS) $(ANALYSIS_OBJS) $(WAMR_OBJS) $(IDE_OBJS) $(APE_OBJS) | $(BUILD_DIR)
	rm -f $@
	$(AR) rcs $@ $^

# Compile object files
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# ZipOS payload: .cosmo/VERSION is what `--self-test` reads back
$(ASSETS_ZIP): VERSION | $(BUILD_DIR)
	rm -rf $(ASSETS_DIR) $@
	mkdir -p $(ASSETS_DIR)/.cosmo
	cp VERSION $(ASSETS_DIR)/.cosmo/VERSION
	cd $(ASSETS_DIR) && $(ZIP) -q -X -r ../assets.zip .cosmo

# Link e9studio.com, then append the ZipOS payload (APE builds only)
E9STUDIO_OBJS = $(E9STUDIO_SRCS:.c=.o)

$(OUTPUT): $(BUILD_DIR)/libe9vendor.a $(E9STUDIO_OBJS) $(if $(IS_COSMO),$(ASSETS_ZIP)) | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(E9STUDIO_OBJS) -L$(BUILD_DIR) -le9vendor -lm -o $@
ifneq ($(IS_COSMO),)
	$(ZIPCOPY) $(ASSETS_ZIP) $@
	@echo "Built APE: $@ (cosmocc $(COSMOCC_VERSION))"
else
	@echo "Built native binary: $@ (CC=$(CC); not an APE, no ZipOS)"
endif

#########################################################################
# GUI Build (tedit-cosmo inspired)
#########################################################################

GUI_OUTPUT = $(BUILD_DIR)/e9studio-gui.com
GUI_CFLAGS = $(CFLAGS) -DE9STUDIO_GUI_STANDALONE

gui: $(GUI_OUTPUT)

$(GUI_OUTPUT): $(BUILD_DIR)/libe9vendor.a $(GUI_OBJS) | $(BUILD_DIR)
	$(CC) $(GUI_CFLAGS) $(GUI_OBJS) -L$(BUILD_DIR) -le9vendor -lm -o $@

# CLI-only build (no GUI dependencies)
cli: $(GUI_OUTPUT)

# GUI object files need the STANDALONE define (it provides main). A
# target-specific variable, because a second `%.o: %.c` pattern rule is
# ignored by make 3.81 (macOS), which picks the first matching pattern.
$(GUI_OBJS): CFLAGS += -DE9STUDIO_GUI_STANDALONE

#########################################################################
# Tests - every step must pass; nothing is swallowed with `|| echo`
#########################################################################

$(BUILD_DIR)/unit:
	mkdir -p $@

# unit tests link everything except e9studio.o (which owns main)
UNIT_LINK_OBJS = $(filter-out %/e9studio.o,$(E9STUDIO_OBJS))

$(BUILD_DIR)/unit/%.com: test/unit/%.c test/unit/testlib.h $(BUILD_DIR)/libe9vendor.a $(UNIT_LINK_OBJS) | $(BUILD_DIR)/unit
	$(CC) $(CFLAGS) -I test/unit $< $(UNIT_LINK_OBJS) -L$(BUILD_DIR) -le9vendor -lm -o $@

unit: $(UNIT_BINS)
	@set -e; for t in $(UNIT_BINS); do echo "== $$t"; ./$$t; done

check: $(OUTPUT) $(GUI_OUTPUT) unit
	@echo "== $(OUTPUT) --self-test"
	./$(OUTPUT) --self-test
	@echo "== $(GUI_OUTPUT) --self-test"
	./$(GUI_OUTPUT) --self-test
	$(MAKE) -C src/e9patch/vendor CC='$(CC)' AR='$(AR)' test

test: check

#########################################################################
# Clean
#########################################################################

clean:
	rm -rf $(BUILD_DIR)
	rm -f $(ALL_OBJS) $(APE_OBJS) $(GUI_OBJS)
	rm -f src/e9patch/vendor/*.o
	rm -f src/e9patch/vendor/libe9vendor.a
	rm -f src/e9patch/vendor/test_vendor src/e9patch/vendor/test_vendor.com.dbg src/e9patch/vendor/test_vendor.aarch64.elf
	rm -f src/e9patch/vendor/wamr/core/iwasm/common/*.o
	rm -f src/e9patch/vendor/wamr/core/shared/platform/cosmopolitan/*.o
	rm -f src/e9patch/analysis/*.o
	rm -f src/e9patch/ide/*.o
	rm -f src/e9patch/*.o
	rm -f src/e9studio/gui/*.o
	rm -f src/e9studio/gui/platform/*.o
	# cosmocc writes the AArch64 half of each object to <dir>/.aarch64/
	find src -type d -name .aarch64 -prune -exec rm -rf {} +

#########################################################################
# WASM Payload Build
#########################################################################

# Binaryen path: check ../binaryen (sibling), then fall back to /opt/binaryen
BINARYEN_PATH ?= $(shell if [ -d "../binaryen" ]; then echo "../binaryen"; \
                         elif [ -d "/opt/binaryen" ]; then echo "/opt/binaryen"; \
                         else echo "binaryen"; fi)

# Build WASM payloads for e9studio
wasm:
	@echo "=== Building WASM Payloads ==="
	$(MAKE) -f src/e9studio/wasm/Makefile.wasm all BINARYEN_PATH=$(BINARYEN_PATH)

# Build binaryen tools (wasm-opt, wasm-as, etc.) as APE binaries
binaryen:
	@echo "=== Building Binaryen Tools ==="
	@if [ -d "$(BINARYEN_PATH)/cosmo" ]; then \
		cd $(BINARYEN_PATH) && ./cosmo/build.sh; \
	else \
		echo "Binaryen not found at $(BINARYEN_PATH)"; \
		echo "Set BINARYEN_PATH or clone it with:"; \
		echo "  git clone https://github.com/ludoplex/binaryen.git ../binaryen"; \
		exit 1; \
	fi

#########################################################################
# Development
#########################################################################

# Build with the host compiler for faster iteration (no APE, no ZipOS)
native:
	$(MAKE) -f Makefile.e9studio CC=cc AR=ar

# Debug build
debug: CFLAGS += -g -O0 -DDEBUG
debug: all

#########################################################################
# Help
#########################################################################

help:
	@echo "E9Studio Build System (cosmocc $(COSMOCC_VERSION))"
	@echo ""
	@echo "Targets:"
	@echo "  toolchain - Fetch and sha256-verify the pinned cosmocc into $(COSMOCC)"
	@echo "  all       - Build e9studio.com (TUI binary, APE)"
	@echo "  gui       - Build e9studio-gui.com (tedit-cosmo GUI framework)"
	@echo "  cli       - Build e9studio-gui.com (alias for gui)"
	@echo "  check     - Build and run unit tests, --self-test and vendor tests"
	@echo "  wasm      - Build WASM payloads for e9studio"
	@echo "  binaryen  - Build binaryen tools (wasm-opt, wasm-as, etc.)"
	@echo "  clean     - Remove build artifacts"
	@echo "  native    - Build with the host cc (not an APE)"
	@echo "  debug     - Build with debug symbols"
	@echo "  vendor    - Build only the vendor library"
	@echo ""
	@echo "Variables:"
	@echo "  COSMOCC   - cosmocc install dir (default: .cosmocc/$(COSMOCC_VERSION))"
	@echo "  CC, AR    - override the compiler (e.g. CC=cc AR=ar for a host build)"
